{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Stock gap — missions agents, point de vue Java",
    "version": "1.0.0",
    "description": "AsyncAPI 3.0.0 ; payloads JSON Schema 2020-12 via Multi Format Schema Objects. Vérification structurelle locale, pas de validation officielle AsyncAPI."
  },
  "defaultContentType": "application/json",
  "servers": {
    "localRedpanda": {
      "host": "redpanda:9092",
      "protocol": "kafka",
      "description": "Réseau Compose interne illustratif"
    }
  },
  "channels": {
    "commands": {
      "address": "stock-gap.agent.commands.v1",
      "description": "Clé Kafka missionId (UUID), JSON UTF-8. Voir kafka-lifecycle.md.",
      "messages": {
        "InvestigationRequested": {
          "$ref": "#/components/messages/InvestigationRequested"
        },
        "RuleSynthesisRequested": {
          "$ref": "#/components/messages/RuleSynthesisRequested"
        },
        "RuleRevisionRequested": {
          "$ref": "#/components/messages/RuleRevisionRequested"
        },
        "ExpertTurnRequested": {
          "$ref": "#/components/messages/ExpertTurnRequested"
        },
        "CancellationRequested": {
          "$ref": "#/components/messages/CancellationRequested"
        }
      },
      "bindings": {
        "kafka": {
          "partitions": 3,
          "replicas": 1,
          "topicConfiguration": {
            "cleanup.policy": [
              "delete"
            ],
            "retention.ms": 86400000
          },
          "bindingVersion": "0.5.0"
        }
      }
    },
    "events": {
      "address": "stock-gap.agent.events.v1",
      "description": "Clé Kafka missionId (UUID), JSON UTF-8. Voir kafka-lifecycle.md.",
      "messages": {
        "MissionStarted": {
          "$ref": "#/components/messages/MissionStarted"
        },
        "ToolObservationRecorded": {
          "$ref": "#/components/messages/ToolObservationRecorded"
        },
        "TextChunkProduced": {
          "$ref": "#/components/messages/TextChunkProduced"
        },
        "DiagnosticProposed": {
          "$ref": "#/components/messages/DiagnosticProposed"
        },
        "RuleChangeProposed": {
          "$ref": "#/components/messages/RuleChangeProposed"
        },
        "RuleChangeNotProposed": {
          "$ref": "#/components/messages/RuleChangeNotProposed"
        },
        "MissionFailed": {
          "$ref": "#/components/messages/MissionFailed"
        },
        "MissionCancelled": {
          "$ref": "#/components/messages/MissionCancelled"
        }
      },
      "bindings": {
        "kafka": {
          "partitions": 3,
          "replicas": 1,
          "topicConfiguration": {
            "cleanup.policy": [
              "delete"
            ],
            "retention.ms": 86400000
          },
          "bindingVersion": "0.5.0"
        }
      }
    },
    "deadLetter": {
      "address": "stock-gap.agent.dead-letter.v1",
      "description": "Clé Kafka missionId (UUID), JSON UTF-8. Voir kafka-lifecycle.md.",
      "messages": {
        "DeadLetter": {
          "$ref": "#/components/messages/DeadLetter"
        }
      },
      "bindings": {
        "kafka": {
          "partitions": 3,
          "replicas": 1,
          "topicConfiguration": {
            "cleanup.policy": [
              "delete"
            ],
            "retention.ms": 604800000
          },
          "bindingVersion": "0.5.0"
        }
      }
    }
  },
  "operations": {
    "dispatchAgentCommand": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/commands"
      },
      "messages": [
        {
          "$ref": "#/channels/commands/messages/InvestigationRequested"
        },
        {
          "$ref": "#/channels/commands/messages/RuleSynthesisRequested"
        },
        {
          "$ref": "#/channels/commands/messages/RuleRevisionRequested"
        },
        {
          "$ref": "#/channels/commands/messages/ExpertTurnRequested"
        },
        {
          "$ref": "#/channels/commands/messages/CancellationRequested"
        }
      ]
    },
    "adoptAgentEvent": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/events"
      },
      "messages": [
        {
          "$ref": "#/channels/events/messages/MissionStarted"
        },
        {
          "$ref": "#/channels/events/messages/ToolObservationRecorded"
        },
        {
          "$ref": "#/channels/events/messages/TextChunkProduced"
        },
        {
          "$ref": "#/channels/events/messages/DiagnosticProposed"
        },
        {
          "$ref": "#/channels/events/messages/RuleChangeProposed"
        },
        {
          "$ref": "#/channels/events/messages/RuleChangeNotProposed"
        },
        {
          "$ref": "#/channels/events/messages/MissionFailed"
        },
        {
          "$ref": "#/channels/events/messages/MissionCancelled"
        }
      ]
    },
    "quarantineInvalidEvent": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/deadLetter"
      },
      "messages": [
        {
          "$ref": "#/channels/deadLetter/messages/DeadLetter"
        }
      ]
    }
  },
