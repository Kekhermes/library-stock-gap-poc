{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deadLetterId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "missionId": {
      "type": "string",
      "format": "uuid"
    },
    "datasetEpoch": {
      "type": "string",
      "format": "uuid"
    },
    "sourceTopic": {
      "type": "string",
      "enum": [
        "stock-gap.agent.commands.v1",
        "stock-gap.agent.events.v1"
      ]
    },
    "sourcePartition": {
      "type": "integer",
      "minimum": 0
    },
    "sourceOffset": {
      "type": "integer",
      "minimum": 0
    },
    "eventId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "failedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "MALFORMED_JSON",
        "SCHEMA_INVALID",
        "UNSUPPORTED_VERSION",
        "POISON_MESSAGE",
        "RETRIES_EXHAUSTED"
      ]
    },
    "deliveryCount": {
      "type": "integer",
      "minimum": 1
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "errorSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "quarantineId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "deadLetterId",
    "schemaVersion",
    "missionId",
    "datasetEpoch",
    "sourceTopic",
    "sourcePartition",
    "sourceOffset",
    "eventId",
    "failedAt",
    "reason",
    "deliveryCount",
    "payloadSha256",
    "errorSummary",
    "quarantineId"
  ],
  "additionalProperties": false
}
