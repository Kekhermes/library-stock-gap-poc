{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SseEvent",
  "oneOf": [
    {
      "$ref": "#/$defs/AnalysisChanged"
    },
    {
      "$ref": "#/$defs/MissionChanged"
    },
    {
      "$ref": "#/$defs/DiagnosticReady"
    },
    {
      "$ref": "#/$defs/ProposalChanged"
    },
    {
      "$ref": "#/$defs/ValidationCompleted"
    },
    {
      "$ref": "#/$defs/PublicationActivated"
    },
    {
      "$ref": "#/$defs/ConversationMessageChanged"
    },
    {
      "$ref": "#/$defs/BatchChanged"
    },
    {
      "$ref": "#/$defs/DatasetReset"
    },
    {
      "$ref": "#/$defs/ResyncRequired"
    }
  ],
  "$defs": {
    "AnalysisChanged": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "AnalysisChanged"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "analysisId": {
              "type": "string",
              "format": "uuid"
            },
            "caseId": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "QUEUED",
                "RUNNING",
                "CANCEL_REQUESTED",
                "SUCCEEDED",
                "FAILED",
                "CANCELLED"
              ]
            }
          },
          "required": [
            "analysisId",
            "caseId",
            "version",
            "state"
          ],
          "additionalProperties": false
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]+$"
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data",
        "cursor"
      ],
      "additionalProperties": false
    },
    "MissionChanged": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "MissionChanged"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "missionId": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "QUEUED",
                "RUNNING",
                "CANCEL_REQUESTED",
                "SUCCEEDED",
                "FAILED",
                "CANCELLED"
              ]
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "cancelRequested": {
              "type": "boolean"
            }
          },
          "required": [
            "missionId",
            "version",
            "state",
            "attempt",
            "cancelRequested"
          ],
          "additionalProperties": false
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]+$"
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data",
        "cursor"
      ],
      "additionalProperties": false
    },
    "DiagnosticReady": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "DiagnosticReady"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "diagnosticId": {
              "type": "string",
              "format": "uuid"
            },
            "analysisId": {
              "type": "string",
              "format": "uuid"
            },
            "caseId": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "conclusion": {
              "type": "string",
              "enum": [
                "SUPPORTED",
                "PARTIAL",
                "INDETERMINATE",
                "CONFLICT"
              ]
            }
          },
          "required": [
            "diagnosticId",
            "analysisId",
            "caseId",
            "version",
            "conclusion"
          ],
          "additionalProperties": false
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]+$"
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data",
        "cursor"
      ],
      "additionalProperties": false
    },
    "ProposalChanged": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ProposalChanged"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "proposalId": {
              "type": "string",
              "format": "uuid"
            },
            "proposalRevision": {
              "type": "integer",
              "minimum": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "DRAFT",
                "VALIDATING",
                "READY",
                "NON_PUBLISHABLE",
                "SUPERSEDED",
                "PUBLISHED",
                "REJECTED"
              ]
            }
          },
          "required": [
            "proposalId",
            "proposalRevision",
            "version",
            "state"
          ],
          "additionalProperties": false
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]+$"
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data",
        "cursor"
      ],
      "additionalProperties": false
    },
    "ValidationCompleted": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ValidationCompleted"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "reportId": {
              "type": "string",
              "format": "uuid"
            },
            "proposalId": {
              "type": "string",
              "format": "uuid"
            },
            "proposalRevision": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "PASSED",
                "FAILED",
                "CANCELLED"
              ]
            },
            "publishable": {
              "type": "boolean"
            }
          },
          "required": [
            "reportId",
            "proposalId",
            "proposalRevision",
            "state",
            "publishable"
          ],
          "additionalProperties": false
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]+$"
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data",
        "cursor"
      ],
      "additionalProperties": false
    },
    "PublicationActivated": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "PublicationActivated"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "publicationId": {
              "type": "string",
              "format": "uuid"
            },
            "ruleSetVersion": {
              "type": "integer",
              "minimum": 1
            },
            "operation": {
              "type": "string",
              "enum": [
                "CREATE",
                "REVISE",
                "RETIRE"
              ]
            }
          },
          "required": [
            "publicationId",
            "ruleSetVersion",
            "operation"
          ],
          "additionalProperties": false
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]+$"
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data",
        "cursor"
      ],
      "additionalProperties": false
    },
    "ConversationMessageChanged": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ConversationMessageChanged"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "conversationId": {
              "type": "string",
              "format": "uuid"
            },
            "messageId": {
              "type": "string",
              "format": "uuid"
            },
            "turnId": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "STREAMING",
                "COMPLETE",
                "INTERRUPTED"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "required": [
            "conversationId",
            "messageId",
            "turnId",
            "version",
            "state",
            "text"
          ],
          "additionalProperties": false
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]+$"
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data",
        "cursor"
      ],
      "additionalProperties": false
    },
    "BatchChanged": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "BatchChanged"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "batchId": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "QUEUED",
                "RUNNING",
                "CANCEL_REQUESTED",
                "SUCCEEDED",
                "FAILED",
                "CANCELLED"
              ]
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "batchId",
            "version",
            "state",
            "completed",
            "total"
          ],
          "additionalProperties": false
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]+$"
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data",
        "cursor"
      ],
      "additionalProperties": false
    },
    "DatasetReset": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "DatasetReset"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "previousDatasetEpoch": {
              "type": "string",
              "format": "uuid"
            },
            "newDatasetEpoch": {
              "type": "string",
              "format": "uuid"
            },
            "action": {
              "const": "FETCH_SYNC_SNAPSHOT"
            }
          },
          "required": [
            "previousDatasetEpoch",
            "newDatasetEpoch",
            "action"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data"
      ],
      "additionalProperties": false
    },
    "ResyncRequired": {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ResyncRequired"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "data": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "CURSOR_EXPIRED",
                "EPOCH_MISMATCH",
                "SLOW_CONSUMER"
              ]
            },
            "action": {
              "const": "FETCH_SYNC_SNAPSHOT"
            }
          },
          "required": [
            "reason",
            "action"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "eventType",
        "schemaVersion",
        "datasetEpoch",
        "occurredAt",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
