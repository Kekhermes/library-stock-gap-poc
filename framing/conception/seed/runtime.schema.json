          "type": "string",
          "format": "uuid"
        },
        "copyId": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "symptom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symptomId",
        "kind",
        "expectedValue",
        "observedValue"
      ],
      "properties": {
        "symptomId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "MISSING",
            "UNEXPECTED_PRESENCE",
            "LOCATION_MISMATCH",
            "STATUS_MISMATCH",
            "COUNT_UNCERTAIN"
          ]
        },
        "expectedValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "copyId",
        "inventoryReferenceTime",
        "status",
        "symptoms"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "format": "uuid"
        },
        "copyId": {
          "type": "string",
          "format": "uuid"
        },
        "inventoryReferenceTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status": {
          "const": "A_ANALYSER"
        },
        "symptoms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symptom"
          },
          "minItems": 1
        }
      }
    },
    "initialRuleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "rules"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleId",
              "ruleVersion",
              "dmnPath"
            ],
            "properties": {
              "ruleId": {
                "const": "R001"
              },
              "ruleVersion": {
                "const": 1
              },
              "dmnPath": {
                "const": "rules/R001-v1.dmn"
              }
            }
          }
        }
      }
    }
  }
}
