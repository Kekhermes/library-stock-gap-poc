  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "profile",
        "seed",
        "referenceTime",
        "capturedAt"
      ],
      "properties": {
        "datasetId": {
          "type": "string",
          "format": "uuid"
        },
        "profile": {
          "enum": [
            "demo",
            "validation",
            "holdout"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "referenceTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "sites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteId",
        "name"
      ],
      "properties": {
        "siteId": {
          "enum": [
            "CENTRE",
            "NORD",
            "SUD"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "locations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locationId",
        "siteId",
        "kind",
        "label"
      ],
      "properties": {
        "locationId": {
          "type": "string",
          "format": "uuid"
        },
        "siteId": {
          "enum": [
            "CENTRE",
            "NORD",
            "SUD"
          ]
        },
        "kind": {
          "enum": [
            "SHELF",
            "RESERVE",
            "RETURNS",
            "RECEIVING",
            "REPAIR"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "titles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titleId",
        "isbn",
        "title"
      ],
      "properties": {
        "titleId": {
          "type": "string",
          "format": "uuid"
        },
        "isbn": {
          "type": "string",
          "pattern": "^[0-9]{13}$"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "copies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyId",
        "barcode",
        "titleId",
        "owningSiteId"
      ],
      "properties": {
        "copyId": {
          "type": "string",
          "format": "uuid"
        },
        "barcode": {
          "type": "string"
        },
        "titleId": {
          "type": "string",
          "format": "uuid"
        },
        "owningSiteId": {
          "enum": [
            "CENTRE",
            "NORD",
            "SUD"
          ]
        }
      }
    },
    "systemStates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyId",
        "status",
        "siteId",
        "locationId",
        "sourceEventIds"
      ],
      "properties": {
        "copyId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "ON_SHELF",
            "ON_LOAN",
            "IN_TRANSIT",
            "RECEIVING",
            "IN_REPAIR",
            "WITHDRAWN",
            "NOT_REGISTERED"
          ]
        },
        "siteId": {
          "enum": [
            "CENTRE",
            "NORD",
            "SUD"
          ]
        },
        "locationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceEventIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "inventoryScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeId",
        "locationId",
        "status",
        "startedAt",
        "closedAt"
