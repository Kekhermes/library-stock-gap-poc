        "observationId": {
          "type": "string",
          "format": "uuid"
        },
        "copyId": {
          "type": "string",
          "format": "uuid"
        },
        "locationId": {
          "type": "string",
          "format": "uuid"
        },
        "scopeId": {
          "type": "string",
          "format": "uuid"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "quality": {
          "enum": [
            "VALID",
            "AMBIGUOUS",
            "REJECTED"
          ]
        }
      }
    },
    "sourceEvents": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceEventId",
            "copyId",
            "eventType",
            "occurredAt",
            "recordedAt",
            "payload"
          ],
          "properties": {
            "sourceEventId": {
              "type": "string",
              "format": "uuid"
            },
            "copyId": {
              "type": "string",
              "format": "uuid"
            },
            "eventType": {
              "const": "LoanOpened"
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operationId",
                "correlationId",
                "siteId",
                "locationId",
                "loanId"
