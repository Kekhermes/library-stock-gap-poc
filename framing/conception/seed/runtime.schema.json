{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trois-rives:seed:runtime:1.0.0",
  "title": "Export normalisé de la simulation de bibliothèque",
  "description": "Contrat structurel strict ; les références et invariants temporels sont contrôlés séparément.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dataset",
    "sites",
    "locations",
    "titles",
    "copies",
    "systemStates",
    "inventoryScopes",
    "observations",
    "sourceEvents",
    "sourceAvailability",
    "operatorNotes",
    "cases",
    "initialRuleSet"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sites"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/locations"
      }
    },
    "titles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/titles"
      }
    },
    "copies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/copies"
      }
    },
    "systemStates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/systemStates"
      }
    },
    "inventoryScopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inventoryScopes"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observations"
      }
    },
    "sourceEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceEvents"
      }
    },
    "sourceAvailability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceAvailability"
      }
    },
    "operatorNotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operatorNotes"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cases"
      }
    },
    "initialRuleSet": {
      "$ref": "#/$defs/initialRuleSet"
    }
