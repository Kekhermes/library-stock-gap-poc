      "ruleId": "8031277f-6e97-4e6a-b92e-2f5824431d2f",
      "ruleName": "Échec d’écriture de projection après réception d’un retour",
      "publication": 2,
      "reportId": "0c60dfe9-9006-452d-9165-763b0749cdba",
