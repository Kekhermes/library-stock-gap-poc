<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             id="definitions_R001_v1" name="R001-v1"
             namespace="urn:library-stock-gap:rules:R001:1">
  <description>Localisation différente constatée, sans attribution de faute. Seule règle bootstrap.</description>
  <inputData id="input_expectedSiteId" name="expectedSiteId">
    <variable id="var_expectedSiteId" name="expectedSiteId" typeRef="string"/>
  </inputData>
  <inputData id="input_expectedLocationId" name="expectedLocationId">
    <variable id="var_expectedLocationId" name="expectedLocationId" typeRef="string"/>
  </inputData>
  <inputData id="input_observedSiteId" name="observedSiteId">
    <variable id="var_observedSiteId" name="observedSiteId" typeRef="string"/>
  </inputData>
  <inputData id="input_observedLocationId" name="observedLocationId">
    <variable id="var_observedLocationId" name="observedLocationId" typeRef="string"/>
  </inputData>
  <inputData id="input_observationReliable" name="observationReliable">
    <variable id="var_observationReliable" name="observationReliable" typeRef="boolean"/>
  </inputData>
  <decision id="decision_location_difference" name="locationDifference">
    <variable id="var_location_difference" name="locationDifference"/>
    <informationRequirement><requiredInput href="#input_expectedSiteId"/></informationRequirement>
    <informationRequirement><requiredInput href="#input_expectedLocationId"/></informationRequirement>
    <informationRequirement><requiredInput href="#input_observedSiteId"/></informationRequirement>
    <informationRequirement><requiredInput href="#input_observedLocationId"/></informationRequirement>
    <informationRequirement><requiredInput href="#input_observationReliable"/></informationRequirement>
    <decisionTable id="table_R001" hitPolicy="COLLECT">
      <input id="col_quality" label="Observation unique et fiable">
        <inputExpression id="expr_quality" typeRef="boolean"><text>observationReliable = true</text></inputExpression>
      </input>
      <input id="col_same_site" label="Même site connu">
        <inputExpression id="expr_same_site" typeRef="boolean"><text>expectedSiteId != null and observedSiteId != null and expectedSiteId = observedSiteId</text></inputExpression>
      </input>
      <input id="col_different_location" label="Emplacements connus différents">
        <inputExpression id="expr_different_location" typeRef="boolean"><text>expectedLocationId != null and observedLocationId != null and expectedLocationId != observedLocationId</text></inputExpression>
      </input>
      <output id="out_cause" name="causeCode" typeRef="string"/>
      <output id="out_status" name="epistemicStatus" typeRef="string"/>
      <rule id="R001_row_1">
        <inputEntry id="quality_true"><text>true</text></inputEntry>
        <inputEntry id="same_site_true"><text>true</text></inputEntry>
        <inputEntry id="different_location_true"><text>true</text></inputEntry>
        <outputEntry id="cause_value"><text>"LOCATION_DIFFERENCE"</text></outputEntry>
        <outputEntry id="status_value"><text>"SUPPORTED"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
